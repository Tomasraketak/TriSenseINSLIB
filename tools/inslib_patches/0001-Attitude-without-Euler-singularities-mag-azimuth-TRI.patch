+        h_n[i] = MAT_ELEM(R_b_to_n, i, 0, 3, 3) * mag_b[0] +
+                 MAT_ELEM(R_b_to_n, i, 1, 3, 3) * mag_b[1] +
+                 MAT_ELEM(R_b_to_n, i, 2, 3, 3) * mag_b[2];
     }
-
